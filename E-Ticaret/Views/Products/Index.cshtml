@model IEnumerable<ETicaretWeb.ViewModels.ProductListViewModel>

@{
    ViewData["Title"] = "Mağaza";
}

<div class="container mt-4">
    <h2 class="fw-bold text-dark mb-4">Mağaza</h2>

    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="alert alert-info text-center shadow-sm py-4">
                    <h5 class="mb-0">Şu anda vitrinde hiç ürün bulunmamaktadır.</h5>
                </div>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm border-0">

                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height: 200px; object-fit: cover; width: 100%;" />

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-dark mb-1">@item.Name</h5>
                            <p class="text-success fw-bold mb-2">@item.FormattedPrice</p>
                            <small class="text-muted mb-3">@item.SellerName</small>

                            <div class="mt-auto">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-dark w-100">İncele</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>