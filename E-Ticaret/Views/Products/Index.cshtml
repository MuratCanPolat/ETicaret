@model IEnumerable<ETicaretWeb.ViewModels.ProductListViewModel>

@{
    ViewData["Title"] = "Mağaza";
}

<div class="container mt-4">
    <h2 class="fw-bold text-dark mb-4">Mağaza</h2>

    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="alert alert-info text-center shadow-sm py-4">
                    <h5 class="mb-0">Şu anda vitrinde hiç ürün bulunmamaktadır.</h5>
                </div>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-12 col-md-4 col-lg-3 mb-4">
                    <div class="card h-100 shadow-sm border-0">
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name">

                        <div class="card-body">
                            <h5 class="card-title fw-bold">@item.Name</h5>
                            <h6 class="card-subtitle mb-2 text-success fw-bold">@item.FormattedPrice</h6>
                            <small class="text-muted"><i class="bi bi-shop"></i> @item.SellerName</small>
                        </div>

                        <div class="card-footer bg-white border-top-0 text-center pb-3">
                            <button class="btn btn-outline-dark w-100">İncele</button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>