@model ETicaretWeb.ViewModels.ProductCreateViewModel

@{
    ViewData["Title"] = "İlanı Düzenle";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-dark text-center py-3">
                    <h4 class="mb-0"><i class="bi bi-pencil-square"></i> İlanı Düzenle</h4>
                </div>
                <div class="card-body p-4">

                    <form asp-action="Edit" asp-route-id="@ViewBag.ProductId" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="text-danger mb-3 fw-bold border p-2 rounded bg-light"></div>

                        <input type="hidden" name="existingImageUrl" value="@ViewBag.ExistingImageUrl" />

                        <div class="form-floating mb-3">
                            <input asp-for="Name" class="form-control" placeholder="Ürün Adı" />
                            <label asp-for="Name"></label>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                                <option value="">-- Lütfen Bir Kategori Seçin --</option>
                            </select>
                            <label asp-for="CategoryId"></label>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00" />
                                    <label asp-for="Price"></label>
                                    <span asp-validation-for="Price" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mt-3 mt-md-0">
                                <div class="form-floating">
                                    <input asp-for="StockQuantity" type="number" class="form-control" placeholder="0" />
                                    <label asp-for="StockQuantity"></label>
                                    <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-floating mb-3">
                            <textarea asp-for="Description" class="form-control" placeholder="Açıklama..." style="height: 100px"></textarea>
                            <label asp-for="Description"></label>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Mevcut Ürün Görseli</label>
                            <div class="mb-2">
                                @if (!string.IsNullOrEmpty(ViewBag.ExistingImageUrl))
                                {
                                    <img src="@ViewBag.ExistingImageUrl" alt="Ürün Görseli" class="img-thumbnail" style="max-height: 120px;" />
                                }
                            </div>

                            <label asp-for="ImageFile" class="form-label fw-bold">Yeni Görsel Yükle (İsteğe Bağlı)</label>
                            <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                            <div class="form-text">Yeni bir görsel seçmezseniz mevcut görsel korunur.</div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="MyProducts" class="btn btn-light border px-4">İptal</a>
                            <button type="submit" class="btn btn-warning px-5 fw-bold">Değişiklikleri Kaydet</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>