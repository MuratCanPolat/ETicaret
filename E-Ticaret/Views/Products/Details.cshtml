@model ETicaret.Core.Entities.Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-5 mb-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> <strong>Başarılı!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="row bg-white p-4 rounded shadow-sm border">

        <div class="col-md-6 mb-4 mb-md-0 text-center">
            <img src="@Model.ImageUrl" class="img-fluid rounded" alt="@Model.Name" style="object-fit: contain; max-height: 500px; width: 100%;" />
        </div>

        <div class="col-md-6 d-flex flex-column justify-content-center">
            <h2 class="fw-bold text-dark">@Model.Name</h2>
            <h3 class="text-primary fw-bold mt-2">@Model.Price.ToString("C")</h3>

            <p class="mt-4 fs-5 text-muted" style="white-space: pre-line;">@Model.Description</p>

            <hr class="my-4" />

            <ul class="list-unstyled mb-4">
                <li class="mb-3 fs-5">
                    <strong><i class="bi bi-box-seam"></i> Stok Durumu:</strong>
                    @if (Model.StockQuantity > 0)
                    {
                        <span class="badge bg-success ms-2">Stokta Var (@Model.StockQuantity Adet)</span>
                    }
                    else
                    {
                        <span class="badge bg-danger ms-2">Tükendi</span>
                    }
                </li>
            </ul>

            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-grid gap-3 d-md-flex mt-auto align-items-center">
                <input type="hidden" name="productId" value="@Model.Id" />

                @if (Model.StockQuantity > 0)
                {
                    <div class="input-group" style="width: 140px;">
                        <span class="input-group-text bg-light fw-bold">Adet</span>
                        <input type="number" name="quantity" class="form-control text-center fw-bold" value="1" min="1" max="@Model.StockQuantity" />
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg px-4">
                        <i class="bi bi-cart-plus"></i> Sepete Ekle
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-secondary btn-lg px-4" disabled>
                        <i class="bi bi-x-circle"></i> Tükendi
                    </button>
                }

                <a asp-action="Index" asp-fragment="urun-@Model.Id" class="btn btn-outline-secondary btn-lg px-4">Mağazaya Dön</a>
            </form>
        </div>

    </div>
</div>