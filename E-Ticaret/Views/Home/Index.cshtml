@model IEnumerable<ETicaretWeb.ViewModels.ProductListViewModel>

@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="container mt-4 mb-5">
    <div class="bg-light p-5 rounded-3 text-center shadow-sm">
        <h1 class="display-5 fw-bold text-primary mb-3">E-Ticaret Dünyasına Hoş Geldiniz</h1>
        <p class="lead text-muted mb-4">
            Yüzlerce kategoride binlerce ürün en uygun fiyat avantajı ve güvenli alışveriş güvencesiyle kapınızda. İhtiyacınız olan her şeyi hemen keşfedin.
        </p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold">Tüm Ürünleri İncele</a>
    </div>
</div>

<div class="container mb-5">
    <h3 class="mb-4 fw-bold border-bottom pb-2">Öne Çıkan Ürünler</h3>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                    <div class="card h-100 shadow-sm border-0">
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height: 200px; object-fit: cover; width: 100%;" />

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-dark mb-1">@item.Name</h5>
                            <p class="text-success fw-bold mb-2">@item.FormattedPrice</p>

                            <div class="mt-auto">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary w-100 fw-bold">İncele</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="bg-info bg-opacity-10 p-5 rounded">
                    <h5 class="text-info fw-bold">Şu an vitrinde öne çıkan bir ürün bulunmuyor.</h5>
                    <p class="text-muted">Yeni ürünlerimiz çok yakında stoklarımıza eklenecektir.</p>
                </div>
            </div>
        }
    </div>
</div>