@model List<E_Ticaret.ViewModels.CartItemViewModel>

@{
    ViewData["Title"] = "Sepetim";
    decimal grandTotal = Model.Sum(x => x.TotalPrice);
}

<div class="container mt-5 mb-5">
    <h2 class="fw-bold mb-4"><i class="bi bi-cart3 text-primary me-2"></i>Alışveriş Sepetim</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center py-5 rounded-4 shadow-sm">
            <i class="bi bi-cart-x" style="font-size: 4rem;"></i>
            <h4 class="mt-3 fw-bold">Sepetiniz şu an boş.</h4>
            <p class="text-muted">Mağazamıza göz atıp harika ürünler bulabilirsiniz.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary rounded-pill px-4 mt-2 fw-bold">Alışverişe Başla</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Ürün</th>
                                        <th>Fiyat</th>
                                        <th>Adet</th>
                                        <th>Toplam</th>
                                        <th class="pe-4 text-end">İşlem</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    <img src="@item.ImageUrl" alt="@item.ProductName" class="img-thumbnail rounded-3 me-3" style="width: 60px; height: 60px; object-fit: cover;" />
                                                    <span class="fw-bold text-dark">@item.ProductName</span>
                                                </div>
                                            </td>
                                            <td class="text-muted">@item.Price.ToString("C")</td>
                                            <td><span class="badge bg-secondary px-3 py-2 fs-6 rounded-pill">@item.Quantity</span></td>
                                            <td class="text-success fw-bold">@item.TotalPrice.ToString("C")</td>
                                            <td class="pe-4 text-end">
                                                <form asp-controller="Cart" asp-action="RemoveFromCart" method="post">
                                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                                    <button type="submit" class="btn btn-danger btn-sm rounded-pill fw-bold shadow-sm px-3">
                                                        <i class="bi bi-trash3-fill me-1"></i> Sil
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary rounded-pill fw-bold"><i class="bi bi-arrow-left me-2"></i>Alışverişe Dön</a>
                    <form asp-controller="Cart" asp-action="ClearCart" method="post">
                        <button type="submit" class="btn btn-outline-danger rounded-pill fw-bold"><i class="bi bi-trash2 me-2"></i>Sepeti Temizle</button>
                    </form>
                </div>
            </div>

            <div class="col-lg-4 mt-4 mt-lg-0">
                <div class="card shadow border-0 rounded-4 bg-primary text-white">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-4 border-bottom border-light pb-2">Sipariş Özeti</h4>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Ara Toplam</span>
                            <span class="fw-bold">@grandTotal.ToString("C")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Kargo Ücreti</span>
                            <span class="fw-bold">Ücretsiz</span>
                        </div>

                        <hr class="border-light opacity-50" />

                        <div class="d-flex justify-content-between mb-4 fs-4">
                            <span class="fw-bold">Genel Toplam</span>
                            <span class="fw-bold">@grandTotal.ToString("C")</span>
                        </div>

                        <a asp-controller="Order" asp-action="Checkout" class="btn btn-light text-primary w-100 rounded-pill fw-bolder py-3 shadow-sm fs-5">
                            Siparişi Tamamla <i class="bi bi-arrow-right ms-2"></i>
                        </a>
                        <small class="d-block text-center mt-3 opacity-75"><i class="bi bi-shield-lock-fill me-1"></i>256-bit SSL Güvenli Ödeme</small>
                    </div>
                </div>
            </div>
        </div>
    }
</div>